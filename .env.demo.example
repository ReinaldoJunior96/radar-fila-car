# Copie para .env.demo e preencha. O .env.demo não vai para o repositório.

# Endereço público. Com sslip.io, troque os pontos do IP da VPS por hífens:
# IP 203.0.113.10  ->  203-0-113-10.sslip.io
DEMO_SITE=203-0-113-10.sslip.io

# Senha do banco. Gere uma com: openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha

# Limites de memória por serviço (VPS com 8 GB). Em 4 GB, use 1024m no banco e no sync.
DB_MEM_LIMIT=1536m
API_MEM_LIMIT=512m
SYNC_MEM_LIMIT=1536m

# Se outro site já usa as portas 80 e 443, mude estas portas ou não suba o caddy
# e aponte o proxy existente para 127.0.0.1:8088.
DEMO_HTTP_PORT=80
DEMO_HTTPS_PORT=443
DEMO_WEB_PORT=8088
